# Copy to .env and fill with real values. NEVER commit .env.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Use "none" only when the frontend and API are on different sites over HTTPS.
# Keep "lax" for same-site (including local Docker over plain HTTP).
COOKIE_SAME_SITE=lax

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_random_hex
JWT_SECRET=replace_with_random_hex

# Either set DATABASE_URL or the individual DB_* values.
# DATABASE_URL=postgresql://user:password@localhost:5432/login
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=login
# DB_SSL=true          # managed databases that require TLS
# DB_POOL_MAX=10

EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Bootstrap/admin credentials. On startup the matching account is created (or
# promoted) and is_admin is granted. Further admins can be added with:
#   cd server && npm run admin:grant -- someone@example.com
# Define the hash with: node -e "require('bcrypt').hash('YOUR_PASSWORD',10).then(console.log)"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2b$10$your_bcrypt_admin_hash

# Payment gateways - see server/.env.sample for all options
PAYMENT_MODE=demo
WEBSITE_URL=http://localhost:3000